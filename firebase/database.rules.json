{
  // Regras de seguranca do Realtime Database do Walk2Win (multiplayer).
  // FONTE DE VERDADE: depois de mudar este ficheiro, correr os testes (firebase/rules-test)
  // e voltar a publicar na consola (Realtime Database -> Regras -> colar -> Publicar).
  //
  // Modelo: rooms/{CODE} = { meta, players/{host|guest}, toss, turns/{n} }.
  //
  // Decisoes / limites (ver tambem o relatorio da tarefa 3):
  // - Ninguem le a raiz nem "rooms" (nao se listam salas).
  // - rooms/$code/meta le-se por QUALQUER utilizador autenticado que saiba o codigo: quem
  //   entra tem de ver status/guest/v antes de ser membro. Troca: com 4 letras (24^4 codigos)
  //   e possivel adivinhar codigos e ver uids anonimos e o estado da sala; por isso meta so
  //   tem uids anonimos, estado e datas (nada de nomes nem jogadas). O resto e so dos membros.
  // - A leitura e dada folha a folha (players, toss, turns/$n/<campo>), NUNCA na sala inteira
  //   nem em turns/$n: no RTDB um .read concedido em cima nao se pode retirar em baixo, e isso
  //   revelaria shot/defend antes do tempo. O cliente tem de escutar cada caminho em separado.
  // - "shot" so e legivel pelo defensor depois de "defend" existir, e vice-versa. O defensor
  //   so pode comecar a escutar shot depois de escrever defend (uma escuta recusada e cancelada).
  // - Inicio da partida (waiting -> playing): so o anfitriao, com os dois ready E os dois
  //   "seen" com menos de 30 s. Por isso o sinal de vida (seen = ServerValue.TIMESTAMP, a
  //   cada 5 s) tem de comecar logo na sala de espera, desde que o registo do jogador existe,
  //   ate ao fim da partida. Assim nao se pode reclamar desistencia logo no arranque.
  // - Uma sala com meta.created ha mais de 2 h pode ser recriada por qualquer autenticado
  //   (o plano gratuito nao tem temporizadores para apagar salas abandonadas). A recriacao
  //   deve substituir a sala inteira (set em rooms/$code); um update so com meta e recusado
  //   se ficarem players/guest, toss, turns ou um players/host de outra pessoa.
  //
  // O QUE ESTAS REGRAS NAO GARANTEM (os clientes tem de verificar e desconfiar):
  // (1) Que a resposta (answer) esteja certa: a chave das perguntas nao esta na BD.
  // (2) Que uma vitoria por "score" corresponda ao marcador: as regras nao fazem ciclos
  //     sobre os turnos nem contam golos. So se exige o proprio papel, a partida a decorrer,
  //     uma so escrita junto com status = finished, e que turns/0..5/answer existam todos
  //     (o jogo nao pode acabar antes de 6 turnos; -1 = tempo esgotado tambem conta).
  //     meta.winner com reason = "score" e NAO CONFIAVEL: cada telemovel recalcula.
  // (3) A ORDEM dos turnos: o anfitriao decide toss/first (quem remata primeiro) e abre os
  //     turnos; um anfitriao batoteiro pode abrir turnos fora de ordem ou saltar os turnos
  //     do convidado. As regras so obrigam shooter a seguir a paridade de toss/first. Os
  //     clientes tem de verificar a ordem dos turnos e tratar toss/first como nao confiavel.
  // (4) Que "cost" corresponda ao jogador do PlayerCatalog e ao saldo (o saldo vive no telemovel).
  // (5) Ocupacao de codigos / negacao de servico: qualquer autenticado pode criar salas ou
  //     ocupar o lugar livre de uma sala em espera cujo codigo adivinhe. So App Check ou
  //     limites de pedidos mitigam isto.
  // (6) "name" pode ser so espacos: o cliente limpa-o com PlayerName.
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        // Criar/recriar (so meta e, opcionalmente, players/host) ou apagar a sala inteira (so o anfitriao).
        ".write": "auth != null && (($code.matches(/^[A-HJ-NP-Z]{4}$/) && (!data.exists() || now - data.child('meta/created').val() > 7200000) && newData.child('meta/host').val() == auth.uid && newData.child('meta/status').val() == 'waiting' && newData.child('meta/v').val() == 1 && newData.child('meta/created').val() == now && !newData.child('meta/guest').exists() && !newData.child('meta/winner').exists() && !newData.child('meta/reason').exists() && (!newData.child('players/host').exists() || newData.child('players/host/uid').val() == auth.uid) && !newData.child('players/guest').exists() && !newData.child('toss').exists() && !newData.child('turns').exists()) || (!newData.exists() && data.child('meta/host').val() == auth.uid))",

        "meta": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['host', 'status', 'v', 'created'])",
          "host": { ".validate": "newData.isString()" },
          "v": { ".validate": "newData.val() == 1" },
          "created": { ".validate": "newData.isNumber()" },
          // Entrar: uma so vez, pelo proprio, numa sala em espera com v == 1.
          "guest": {
            ".write": "auth != null && !data.exists() && newData.val() == auth.uid && auth.uid != data.parent().child('host').val() && data.parent().child('status').val() == 'waiting' && data.parent().child('v').val() == 1",
            ".validate": "newData.isString()"
          },
          // waiting -> playing: so o anfitriao, com os dois ready e os dois seen < 30 s. playing -> finished: so junto com winner.
          "status": {
            ".write": "auth != null && ((data.val() == 'waiting' && newData.val() == 'playing' && auth.uid == data.parent().child('host').val() && data.parent().child('guest').exists() && root.child('rooms').child($code).child('players/host/ready').val() == true && root.child('rooms').child($code).child('players/guest/ready').val() == true && now - root.child('rooms').child($code).child('players/host/seen').val() < 30000 && now - root.child('rooms').child($code).child('players/guest/seen').val() < 30000) || (data.val() == 'playing' && newData.val() == 'finished' && (auth.uid == data.parent().child('host').val() || auth.uid == data.parent().child('guest').val()) && newData.parent().child('winner').exists() && !data.parent().child('winner').exists()))",
            ".validate": "newData.val() == 'waiting' || newData.val() == 'playing' || newData.val() == 'finished'"
          },
          // winner + reason + status = finished, numa so escrita (update em meta), com o proprio papel.
          // forfeit: adversario sem sinal ha mais de 30000 ms (hora do servidor).
          // score: turns/0..5/answer existem todos (NAO verifica o marcador; ver (2) acima).
          "winner": {
            ".write": "auth != null && !data.exists() && data.parent().child('status').val() == 'playing' && newData.parent().child('status').val() == 'finished' && ((newData.val() == 'host' && auth.uid == data.parent().child('host').val()) || (newData.val() == 'guest' && auth.uid == data.parent().child('guest').val())) && ((newData.parent().child('reason').val() == 'score' && root.child('rooms').child($code).child('turns/0/answer').exists() && root.child('rooms').child($code).child('turns/1/answer').exists() && root.child('rooms').child($code).child('turns/2/answer').exists() && root.child('rooms').child($code).child('turns/3/answer').exists() && root.child('rooms').child($code).child('turns/4/answer').exists() && root.child('rooms').child($code).child('turns/5/answer').exists()) || (newData.parent().child('reason').val() == 'forfeit' && ((newData.val() == 'host' && now - root.child('rooms').child($code).child('players/guest/seen').val() > 30000) || (newData.val() == 'guest' && now - root.child('rooms').child($code).child('players/host/seen').val() > 30000))))",
            ".validate": "newData.val() == 'host' || newData.val() == 'guest'"
          },
          "reason": {
            ".write": "auth != null && !data.exists() && newData.parent().child('winner').exists() && !data.parent().child('winner').exists()",
            ".validate": "newData.val() == 'score' || newData.val() == 'forfeit'"
          },
          "$other": { ".validate": false }
        },

        "players": {
          ".read": "auth != null && (auth.uid == root.child('rooms').child($code).child('meta/host').val() || auth.uid == root.child('rooms').child($code).child('meta/guest').val())",
          "$role": {
            // Registo inteiro: so o dono (uid em meta.host/meta.guest), em espera e sem ready.
            // Usa newData para meta.guest para permitir entrar e criar o registo numa so escrita.
            ".write": "auth != null && newData.exists() && newData.parent().parent().child('meta').child($role).val() == auth.uid && root.child('rooms').child($code).child('meta/status').val() == 'waiting' && data.child('ready').val() != true",
            ".validate": "($role == 'host' || $role == 'guest') && newData.hasChildren(['uid', 'name', 'player', 'cost', 'ready', 'seen'])",
            "uid": { ".validate": "newData.val() == auth.uid" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
            "player": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "cost": { ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000" },
            "ready": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child($role).val() == auth.uid && root.child('rooms').child($code).child('meta/status').val() == 'waiting'",
              ".validate": "newData.isBoolean()"
            },
            // Sinal de vida: so o dono e so com ServerValue.TIMESTAMP.
            "seen": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child($role).val() == auth.uid",
              ".validate": "newData.val() == now"
            },
            "$other": { ".validate": false }
          }
        },

        "toss": {
          ".read": "auth != null && (auth.uid == root.child('rooms').child($code).child('meta/host').val() || auth.uid == root.child('rooms').child($code).child('meta/guest').val())",
          "guestChoice": {
            ".write": "auth != null && !data.exists() && auth.uid == root.child('rooms').child($code).child('meta/guest').val()",
            ".validate": "newData.val() == 'heads' || newData.val() == 'tails'"
          },
          "first": {
            ".write": "auth != null && !data.exists() && auth.uid == root.child('rooms').child($code).child('meta/host').val() && data.parent().child('guestChoice').exists()",
            ".validate": "newData.val() == 'host' || newData.val() == 'guest'"
          },
          "$other": { ".validate": false }
        },

        "turns": {
          "$n": {
            // Abrir o turno: so o anfitriao, uma vez, com a partida a decorrer ({shooter, q} e mais nada).
            ".write": "auth != null && !data.exists() && auth.uid == root.child('rooms').child($code).child('meta/host').val() && root.child('rooms').child($code).child('meta/status').val() == 'playing' && $n.matches(/^(0|[1-9][0-9]{0,2})$/) && newData.hasChildren(['shooter', 'q']) && !newData.hasChild('answer') && !newData.hasChild('shot') && !newData.hasChild('defend')",
            ".validate": "$n.matches(/^(0|[1-9][0-9]{0,2})$/)",
            "shooter": {
              ".read": "auth != null && (auth.uid == root.child('rooms').child($code).child('meta/host').val() || auth.uid == root.child('rooms').child($code).child('meta/guest').val())",
              ".write": "auth != null && !data.exists() && auth.uid == root.child('rooms').child($code).child('meta/host').val() && root.child('rooms').child($code).child('meta/status').val() == 'playing' && $n.matches(/^(0|[1-9][0-9]{0,2})$/)",
              // Turno par remata quem comeca (toss/first); impar, o outro (TurnOrder).
              ".validate": "(newData.val() == 'host' || newData.val() == 'guest') && root.child('rooms').child($code).child('toss/first').exists() && ((newData.val() == root.child('rooms').child($code).child('toss/first').val() && $n.matches(/[02468]$/)) || (newData.val() != root.child('rooms').child($code).child('toss/first').val() && !$n.matches(/[02468]$/)))"
            },
            "q": {
              ".read": "auth != null && (auth.uid == root.child('rooms').child($code).child('meta/host').val() || auth.uid == root.child('rooms').child($code).child('meta/guest').val())",
              ".write": "auth != null && !data.exists() && auth.uid == root.child('rooms').child($code).child('meta/host').val() && root.child('rooms').child($code).child('meta/status').val() == 'playing' && $n.matches(/^(0|[1-9][0-9]{0,2})$/)",
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() < 10000"
            },
            // So o atirador, uma vez; -1 = tempo esgotado.
            "answer": {
              ".read": "auth != null && (auth.uid == root.child('rooms').child($code).child('meta/host').val() || auth.uid == root.child('rooms').child($code).child('meta/guest').val())",
              ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('meta/status').val() == 'playing' && ((root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'host' && auth.uid == root.child('rooms').child($code).child('meta/host').val()) || (root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'guest' && auth.uid == root.child('rooms').child($code).child('meta/guest').val()))",
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= -1 && newData.val() <= 2"
            },
            // Escrita unica, so o atirador, so depois de answer (>= 0). Revelado ao defensor depois de defend.
            "shot": {
              ".read": "auth != null && (((root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'host' && auth.uid == root.child('rooms').child($code).child('meta/host').val()) || (root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'guest' && auth.uid == root.child('rooms').child($code).child('meta/guest').val())) || (((root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'host' && auth.uid == root.child('rooms').child($code).child('meta/guest').val()) || (root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'guest' && auth.uid == root.child('rooms').child($code).child('meta/host').val())) && root.child('rooms').child($code).child('turns').child($n).child('defend').exists()))",
              ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('meta/status').val() == 'playing' && ((root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'host' && auth.uid == root.child('rooms').child($code).child('meta/host').val()) || (root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'guest' && auth.uid == root.child('rooms').child($code).child('meta/guest').val())) && root.child('rooms').child($code).child('turns').child($n).child('answer').val() >= 0",
              ".validate": "newData.hasChildren(['zone', 'nonce'])",
              "zone": { ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 14" },
              // Ate 2^53 - 1: acima disso um long perde precisao como double.
              "nonce": { ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 9007199254740991" },
              "$other": { ".validate": false }
            },
            // Escrita unica, so o defensor, so depois de answer (>= 0). Revelado ao atirador depois de shot.
            "defend": {
              ".read": "auth != null && (((root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'host' && auth.uid == root.child('rooms').child($code).child('meta/guest').val()) || (root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'guest' && auth.uid == root.child('rooms').child($code).child('meta/host').val())) || (((root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'host' && auth.uid == root.child('rooms').child($code).child('meta/host').val()) || (root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'guest' && auth.uid == root.child('rooms').child($code).child('meta/guest').val())) && root.child('rooms').child($code).child('turns').child($n).child('shot').exists()))",
              ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('meta/status').val() == 'playing' && ((root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'host' && auth.uid == root.child('rooms').child($code).child('meta/guest').val()) || (root.child('rooms').child($code).child('turns').child($n).child('shooter').val() == 'guest' && auth.uid == root.child('rooms').child($code).child('meta/host').val())) && root.child('rooms').child($code).child('turns').child($n).child('answer').val() >= 0",
              ".validate": "newData.hasChildren(['zone', 'nonce'])",
              "zone": { ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 4" },
              "nonce": { ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 9007199254740991" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
