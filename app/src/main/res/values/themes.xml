<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema único da app (só modo escuro): Material 3 escuro com a paleta Walk2Win.
        Mantém o AppCompatViewInflater para que <Button> continue a ser um botão simples
        (o MaterialButton ignoraria os fundos desenhados pelos estilos W2W).
    -->
    <style name="Theme.Walk2Win" parent="Theme.Material3.Dark.NoActionBar">
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>

        <item name="colorPrimary">@color/gold_500</item>
        <item name="colorOnPrimary">@color/text_on_gold</item>
        <item name="colorSecondary">@color/grass_500</item>
        <item name="colorOnSecondary">@color/text_on_gold</item>
        <item name="colorSurface">@color/pitch_800</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/feedback_error</item>

        <item name="android:colorBackground">@color/pitch_900</item>
        <item name="android:windowBackground">@color/pitch_900</item>
        <item name="android:navigationBarColor">@color/pitch_900</item>
        <item name="android:statusBarColor">@color/pitch_900</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/barlow</item>

    </style>

    <!-- Splash (androidx.core:core-splashscreen): fundo escuro e a bola dourada, em todas as versões.
         Só a MainActivity o usa; depois do arranque passa a Theme.Walk2Win. -->
    <style name="Theme.Walk2Win.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pitch_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Walk2Win</item>
    </style>
</resources>
