    <string name="ui_help_text_4">🎯 FASES DO JOGO</string>
    <string name="ui_help_text_5">1</string>
    <string name="ui_help_text_6">Sorteio Inicial</string>
    <string name="ui_help_text_7">Cara ou coroa para decidir quem começa a bater primeiro</string>
