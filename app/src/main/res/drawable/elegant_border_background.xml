<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base color with transparency -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC1B1313" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#DC5E5E" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Inner shadow effect -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>