<?xml version="1.0" encoding="utf-8"?>
<!-- Botão principal: dourado com "degrau" inferior (aspeto 3D como nos menus de jogos) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/pitch_600" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="@color/gold_700" />
                            <corners android:radius="@dimen/radius_md" />
                        </shape>
                    </item>
                    <item android:bottom="3dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:startColor="@color/gold_300"
                                android:endColor="@color/gold_500" />
                            <corners android:radius="@dimen/radius_md" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</ripple>
