<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo de ecrã: verde-escuro com um brilho de projetor de estádio no topo. Quase sem peso. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pitch_900" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="90%p"
                android:startColor="#3322C55E"
                android:endColor="#0022C55E" />
        </shape>
    </item>
</layer-list>
