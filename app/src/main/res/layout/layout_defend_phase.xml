<?xml version="1.0" encoding="utf-8"?>
<!--
    Fase de defesa: o jogador escolhe uma de 5 zonas; o adversário remata para uma delas.
    O banner DEFENDIDO!/GOLO! substitui a instrução, e o detalhe aparece por baixo da baliza.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDefend"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_lg">

    <FrameLayout
        android:id="@+id/slotDefend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/cardDefendInstruction"
            style="@style/Widget.W2W.Card.Highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/icon_front_hand"
                app:tint="@color/gold_500" />

            <TextView
                android:id="@+id/tvDefendInstruction"
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/ui_defend_tv_defend_instruction"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDefendBanner"
            style="@style/TextAppearance.W2W.Display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ds_banner_info"
            android:gravity="center"
            android:visibility="invisible"
            tools:text="DEFENDIDO!" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/defendGoalArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/ds_goal_backdrop"
        android:padding="@dimen/space_sm"
        app:layout_constraintBottom_toTopOf="@id/tvDefendDetail"
        app:layout_constraintDimensionRatio="H,5:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slotDefend"
        app:layout_constraintVertical_bias="0.3"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/ds_goal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/defenseGrid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:columnCount="3"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl"
            android:rowCount="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

                <View
                    android:id="@+id/rect_top_left"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="0"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_defend_idle"
                    android:tag="top_left" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="1"
                    android:layout_row="0"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1" />

                <View
                    android:id="@+id/rect_top_right"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="0"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_defend_idle"
                    android:tag="top_right" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="1"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1" />

                <View
                    android:id="@+id/rect_center"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="1"
                    android:layout_row="1"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_defend_idle"
                    android:tag="center" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="1"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1" />

                <View
                    android:id="@+id/rect_bottom_left"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="0"
                    android:layout_row="2"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_defend_idle"
                    android:tag="bottom_left" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="1"
                    android:layout_row="2"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1" />

                <View
                    android:id="@+id/rect_bottom_right"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_column="2"
                    android:layout_row="2"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_defend_idle"
                    android:tag="bottom_right" />

        </GridLayout>

        <!-- Bola do adversário -->
        <ImageView
            android:id="@+id/defendBall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/icon_sports_soccer"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvDefendDetail"
        style="@style/TextAppearance.W2W.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:minLines="2"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/defendGoalArea"
        tools:text="Adversário chutou: Canto superior esquerdo\nDefendeste: Centro" />
</androidx.constraintlayout.widget.ConstraintLayout>
