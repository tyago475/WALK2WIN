<?xml version="1.0" encoding="utf-8"?>
<!--
    Escolha do jogador: carrossel de cartas estilo Ultimate Team, saldo no topo
    e botão de confirmar em baixo (mostra o custo).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.W2W.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/selectionContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg">

        <!-- Barra de topo: voltar + título -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/ds_icon_button"
                android:contentDescription="@string/select_back_description"
                android:src="@drawable/icon_arrow_back"
                android:tint="@color/gold_300" />

            <TextView
                style="@style/TextAppearance.W2W.Title"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:text="@string/select_title"
                android:textAllCaps="true" />
        </FrameLayout>

        <TextView
            style="@style/TextAppearance.W2W.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/select_subtitle" />

        <!-- Saldo -->
        <LinearLayout
            style="@style/Widget.W2W.Card.Highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_bolt"
                android:tint="@color/gold_500" />

            <TextView
                android:id="@+id/tvAvailablePoints"
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textColor="@color/gold_300"
                tools:text="Pontos disponíveis: 300" />
        </LinearLayout>

        <!-- Carrossel -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerPlayers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutDots"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="@android:color/transparent"
            app:tabBackground="@drawable/ds_tab_dot"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabMinWidth="0dp"
            app:tabMode="fixed"
            app:tabRippleColor="@null" />

        <TextView
            android:id="@+id/tvSelectedPlayer"
            style="@style/TextAppearance.W2W.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            tools:text="Jogador selecionado: Maguire" />

        <Button
            android:id="@+id/btnConfirmSelection"
            style="@style/Widget.W2W.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/select_confirm" />
    </LinearLayout>
</FrameLayout>
