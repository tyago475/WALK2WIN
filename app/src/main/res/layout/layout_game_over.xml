<?xml version="1.0" encoding="utf-8"?>
<!--
    Fim de jogo: medalha (dourada se ganhaste), resultado, marcador grande e botão de voltar.
    Usa o fundo do ecrã do jogo; o código (GameOverView) preenche textos, cores e ícone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <FrameLayout
        android:id="@+id/gameOverBadge"
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:background="@drawable/ds_coin"
        android:elevation="@dimen/elevation_high">

        <ImageView
            android:id="@+id/ivGameOverIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/icon_emoji_events" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGameOverTitle"
        style="@style/TextAppearance.W2W.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        android:text="@string/gameover_title"
        tools:text="FIM DE JOGO" />

    <TextView
        android:id="@+id/tvGameOverResult"
        style="@style/TextAppearance.W2W.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textColor="@color/gold_500"
        tools:text="TU VENCESTE!" />

    <!-- Marcador -->
    <LinearLayout
        style="@style/Widget.W2W.Card.Highlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGameOverScore"
            style="@style/TextAppearance.W2W.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="56sp"
            tools:text="3 × 2" />

        <TextView
            android:id="@+id/tvGameOverPlayers"
            style="@style/TextAppearance.W2W.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Maguire vs Taremi" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGameOverMessage"
        style="@style/TextAppearance.W2W.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        tools:text="Parabéns! Foi um grande jogo!" />

    <Button
        android:id="@+id/btnBackToMain"
        style="@style/Widget.W2W.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_xl"
        android:drawableStart="@drawable/icon_home"
        android:drawableTint="@color/text_on_gold"
        android:drawablePadding="@dimen/space_sm"
        android:text="@string/ui_gameover_btn_back_to_main" />
</LinearLayout>
