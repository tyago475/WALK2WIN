<?xml version="1.0" encoding="utf-8"?>
<!--
    Transição entre fases (golo, falhanço, morte súbita...). Fica dentro do contentor das fases,
    por isso o cabeçalho com a pontuação continua visível. O fundo é o do ecrã.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <FrameLayout
        android:id="@+id/transitionBadge"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:background="@drawable/ds_badge_good"
        android:elevation="@dimen/elevation_high"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/ivTransitionIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/icon_sports_soccer" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTransitionMessage"
        style="@style/TextAppearance.W2W.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center"
        tools:text="GOLAÇO!" />

    <TextView
        android:id="@+id/tvTransitionSubtitle"
        style="@style/TextAppearance.W2W.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        tools:text="A seguir: defendes" />
</LinearLayout>
