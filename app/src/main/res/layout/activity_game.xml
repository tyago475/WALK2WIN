<?xml version="1.0" encoding="utf-8"?>
<!--
    Ecrã do jogo: cabeçalho (pontuação) + uma de várias fases, todas no mesmo espaço.
    O código mostra uma fase de cada vez (GameActivity.showOnly).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.W2W.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/gameContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            layout="@layout/layout_game_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/layoutQuestion"
                layout="@layout/layout_quiz_phase"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/layoutShoot"
                layout="@layout/layout_shoot_phase"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/layoutDefend"
                layout="@layout/layout_defend_phase"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/coinTossPhase"
                layout="@layout/layout_coin_toss"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/gameOverPhase"
                layout="@layout/layout_game_over"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
