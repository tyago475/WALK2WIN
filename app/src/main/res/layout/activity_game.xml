<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E">

    <!-- Conteúdo principal ocupa todo o espaço -->
    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Todas as fases ocupam o mesmo espaço -->
        <include
            android:id="@+id/layoutQuestion"
            layout="@layout/layout_quiz_phase"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/layoutShoot"
            layout="@layout/layout_shoot_phase"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/layoutDefend"
            layout="@layout/layout_defend_phase"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/coinTossPhase"
            layout="@layout/layout_coin_toss"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/gameOverPhase"
            layout="@layout/layout_game_over"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>