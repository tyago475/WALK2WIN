<?xml version="1.0" encoding="utf-8"?>
<!--
    Cabeçalho do jogo: tempo (só no quiz) e os dois jogadores com os 5 penáltis de cada um.
    Fica visível durante o quiz, o remate e a defesa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <!-- Tempo -->
    <TextView
        android:id="@+id/tvTimer"
        style="@style/TextAppearance.W2W.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ds_timer_ok"
        android:drawablePadding="@dimen/space_sm"
        android:drawableStart="@drawable/icon_timer"
        android:drawableTint="@color/text_on_gold"
        android:gravity="center"
        android:minWidth="96dp"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        android:textColor="@color/text_on_gold"
        tools:text="10s" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tu -->
        <LinearLayout
            android:id="@+id/cardPlayer1"
            style="@style/Widget.W2W.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <ImageView
                android:id="@+id/ivPlayer1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ds_avatar_user"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/maguire" />

            <TextView
                android:id="@+id/tvPlayer1"
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Maguire" />

            <LinearLayout
                android:id="@+id/scorePlayer1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <ImageView android:id="@+id/score_circle_1_1" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_1_2" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_1_3" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_1_4" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_1_5" style="@style/Widget.W2W.ScoreDot" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvVS"
            style="@style/TextAppearance.W2W.Title"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@drawable/ds_vs_badge"
            android:gravity="center"
            android:text="@string/game_vs"
            android:textColor="@color/gold_500"
            android:textSize="@dimen/text_label" />

        <!-- Adversário -->
        <LinearLayout
            android:id="@+id/cardPlayer2"
            style="@style/Widget.W2W.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <ImageView
                android:id="@+id/ivPlayer2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/ds_avatar_bot"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/cr7" />

            <TextView
                android:id="@+id/tvPlayer2"
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="CR7" />

            <LinearLayout
                android:id="@+id/scorePlayer2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <ImageView android:id="@+id/score_circle_2_1" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_2_2" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_2_3" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_2_4" style="@style/Widget.W2W.ScoreDot" />
                <ImageView android:id="@+id/score_circle_2_5" style="@style/Widget.W2W.ScoreDot" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
