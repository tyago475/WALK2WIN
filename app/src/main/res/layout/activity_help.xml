<?xml version="1.0" encoding="utf-8"?>
<!--
    Ajuda: fases do jogo (passos numerados), dicas e sistema de pontos.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.W2W.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ds_pitch_lines" />

    <ScrollView
        android:id="@+id/helpScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_help_outline"
                android:tint="@color/gold_500" />

            <TextView
                style="@style/TextAppearance.W2W.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_help_text_2"
                android:textColor="@color/gold_500" />

            <TextView
                style="@style/TextAppearance.W2W.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_help_text_3" />

        <LinearLayout
            style="@style/Widget.W2W.Card.Highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/ui_help_text_4"
                android:textColor="@color/gold_500" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.W2W.StepNumber"
                    android:text="@string/ui_help_text_5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_help_text_6" />

                    <TextView
                        style="@style/TextAppearance.W2W.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:lineSpacingExtra="@dimen/space_xs"
                        android:text="@string/ui_help_text_7"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.W2W.StepNumber"
                    android:text="@string/ui_help_text_8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_help_text_9" />

                    <TextView
                        style="@style/TextAppearance.W2W.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:lineSpacingExtra="@dimen/space_xs"
                        android:text="@string/ui_help_text_10"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.W2W.StepNumber"
                    android:text="@string/ui_help_text_11" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_help_text_12" />

                    <TextView
                        style="@style/TextAppearance.W2W.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:lineSpacingExtra="@dimen/space_xs"
                        android:text="@string/ui_help_text_13"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.W2W.StepNumber"
                    android:text="@string/ui_help_text_14" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_help_text_15" />

                    <TextView
                        style="@style/TextAppearance.W2W.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:lineSpacingExtra="@dimen/space_xs"
                        android:text="@string/ui_help_text_16"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.W2W.StepNumber"
                    android:text="@string/ui_help_text_17" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_help_text_18" />

                    <TextView
                        style="@style/TextAppearance.W2W.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:lineSpacingExtra="@dimen/space_xs"
                        android:text="@string/ui_help_text_19"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.W2W.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/ui_help_text_20"
                android:textColor="@color/grass_400" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_star"
                    android:tint="@color/gold_500" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_21" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_check_circle"
                    android:tint="@color/grass_400" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_22" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_bolt"
                    android:tint="@color/gold_500" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_23" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_timer"
                    android:tint="@color/gold_500" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_sports_soccer"
                    android:tint="@color/grass_400" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_25" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.W2W.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:text="@string/ui_help_text_26"
                android:textColor="@color/gold_500" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_directions_walk"
                    android:tint="@color/grass_400" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_27" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_paid"
                    android:tint="@color/gold_500" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_28" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_star"
                    android:tint="@color/gold_500" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_29" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.W2W.ListIcon"
                    android:src="@drawable/icon_flag"
                    android:tint="@color/grass_400" />

                <TextView
                    style="@style/Widget.W2W.ListText"
                    android:text="@string/ui_help_text_30" />
            </LinearLayout>
        </LinearLayout>

            <Button
                android:id="@+id/btnBackToMain"
                style="@style/Widget.W2W.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/ui_help_btn_back_to_main" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
