<?xml version="1.0" encoding="utf-8"?>
<!--
    Fase de remate: instrução (substituída pelo banner GOLO!/FALHOU! no fim),
    baliza desenhada com 15 zonas e a bola que voa até à zona escolhida.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutShoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_lg">

    <FrameLayout
        android:id="@+id/slotShoot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/cardInstruction"
            style="@style/Widget.W2W.Card.Highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/icon_sports_soccer"
                app:tint="@color/gold_500" />

            <TextView
                android:id="@+id/tvShootInstruction"
                style="@style/TextAppearance.W2W.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/ui_shoot_tv_shoot_instruction"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvShootBanner"
            style="@style/TextAppearance.W2W.Display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ds_banner_success"
            android:gravity="center"
            android:visibility="invisible"
            tools:text="GOLO!" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/goalArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@drawable/ds_goal_backdrop"
        android:padding="@dimen/space_sm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,5:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slotShoot"
        app:layout_constraintVertical_bias="0.3">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/ds_goal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
            android:id="@+id/layoutCircles"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:columnCount="5"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl"
            android:rowCount="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

                <!-- Fila 1 -->
                <View
                    android:id="@+id/circle_1_1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="top_left" />

                <View
                    android:id="@+id/circle_1_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="top_left_center" />

                <View
                    android:id="@+id/circle_1_3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="top_center" />

                <View
                    android:id="@+id/circle_1_4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="top_right_center" />

                <View
                    android:id="@+id/circle_1_5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="top_right" />

                <!-- Fila 2 -->
                <View
                    android:id="@+id/circle_2_1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="middle_left" />

                <View
                    android:id="@+id/circle_2_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="middle_center_left" />

                <View
                    android:id="@+id/circle_2_3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="middle_center" />

                <View
                    android:id="@+id/circle_2_4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="middle_center_right" />

                <View
                    android:id="@+id/circle_2_5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="middle_right" />

                <!-- Fila 3 -->
                <View
                    android:id="@+id/circle_3_1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="bottom_left" />

                <View
                    android:id="@+id/circle_3_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="bottom_left_center" />

                <View
                    android:id="@+id/circle_3_3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="bottom_center" />

                <View
                    android:id="@+id/circle_3_4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="bottom_right_center" />

                <View
                    android:id="@+id/circle_3_5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="@dimen/space_xs"
                    android:background="@drawable/ds_zone_idle"
                    android:tag="bottom_right" />

        </GridLayout>

        <!-- Bola: o código posiciona-a e anima-a até à zona escolhida -->
        <ImageView
            android:id="@+id/ballIndicator"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/icon_sports_soccer"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
