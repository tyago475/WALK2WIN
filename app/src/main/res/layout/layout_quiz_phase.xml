<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutQuestion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Header -->
    <include
        layout="@layout/layout_game_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Conteúdo da Quiz Phase -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/stadium_background"
        android:gravity="center">

        <!-- Card da Pergunta -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            app:cardCornerRadius="20dp"
            app:cardElevation="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/question_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <!-- Ícone da Pergunta -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❓"
                    android:textSize="48sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/question_icon_background" />

                <!-- Texto da Pergunta -->
                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/question_text_background"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:text="Pergunta aparecerá aqui..."
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Opções -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnOption1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="A) Opção A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/option_button_background"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    style="@style/Widget.AppCompat.Button.Borderless" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnOption2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="B) Opção B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/option_button_background"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    style="@style/Widget.AppCompat.Button.Borderless" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp">

                <Button
                    android:id="@+id/btnOption3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="C) Opção C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/option_button_background"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    style="@style/Widget.AppCompat.Button.Borderless" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- 🔥 BOTÃO PRÓXIMA RODADA REMOVIDO -->

    </LinearLayout>

</LinearLayout>