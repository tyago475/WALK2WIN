<?xml version="1.0" encoding="utf-8"?>
<!--
    Fase do quiz: cartão da pergunta (também mostra as mensagens de resultado,
    com o fundo a mudar de cor) e as três respostas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutQuestion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_lg">

    <TextView
        android:id="@+id/tvQuestion"
        style="@style/TextAppearance.W2W.Title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/ds_banner_neutral"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:textSize="26sp"
        tools:text="Qual é a capital do Canadá?" />

    <Button
        android:id="@+id/btnOption1"
        style="@style/Widget.W2W.Button.Answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        tools:text="A) Toronto" />

    <Button
        android:id="@+id/btnOption2"
        style="@style/Widget.W2W.Button.Answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        tools:text="B) Vancouver" />

    <Button
        android:id="@+id/btnOption3"
        style="@style/Widget.W2W.Button.Answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        tools:text="C) Ottawa" />
</LinearLayout>
