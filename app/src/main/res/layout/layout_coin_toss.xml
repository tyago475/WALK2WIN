<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/stadium_background"
    android:padding="12dp">

    <!-- Título Principal -->
    <TextView
        android:id="@+id/tvCoinTossTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="LANÇAMENTO DA MOEDA"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvCoinTossSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_coin_tv_coin_toss_subtitle"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Container da Moeda Animada -->
    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:background="@drawable/circle_gold_border"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvCoinAnimation"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            tools:text="🪙"
            android:textSize="30sp"
            android:background="@drawable/circle_gold"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCoinTossMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Escolha Cara ou Coroa:"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:weightSum="2">

        <!-- Botão Cara -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#B71C1C">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/button_blue_gradient"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_coin_text_1"
                    android:textSize="22sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnHeads"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    tools:text="CARA"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_selector_blue"
                    android:padding="8dp"
                    android:minHeight="40dp"
                    android:minWidth="100dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Botão Coroa -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#757575">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/button_green_gradient"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_coin_text_2"
                    android:textSize="22sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnTails"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    tools:text="COROA"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_selector_green"
                    android:padding="8dp"
                    android:minHeight="40dp"
                    android:minWidth="100dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <TextView
        android:id="@+id/tvCoinTossHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_coin_tv_coin_toss_hint"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:gravity="center" />

</LinearLayout>