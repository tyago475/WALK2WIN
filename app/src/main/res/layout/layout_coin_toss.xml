<?xml version="1.0" encoding="utf-8"?>
<!--
    Cara ou coroa: moeda dourada desenhada que roda, e duas escolhas grandes.
    Depois de escolher, a escolha fica verde (acertou) ou vermelha (falhou).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <TextView
        android:id="@+id/tvCoinTossTitle"
        style="@style/TextAppearance.W2W.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/gold_300"
        tools:text="LANÇAMENTO DA MOEDA" />

    <TextView
        android:id="@+id/tvCoinTossSubtitle"
        style="@style/TextAppearance.W2W.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:text="@string/ui_coin_tv_coin_toss_subtitle" />

    <!-- A moeda -->
    <FrameLayout
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_marginTop="@dimen/space_xxl"
        android:layout_marginBottom="@dimen/space_xxl"
        android:background="@drawable/ds_coin"
        android:elevation="@dimen/elevation_high">

        <ImageView
            android:id="@+id/ivCoin"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/icon_paid"
            app:tint="@color/text_on_gold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCoinTossMessage"
        style="@style/TextAppearance.W2W.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="4"
        tools:text="Escolhe cara ou coroa" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHeads"
            style="@style/Widget.W2W.Button.Answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:drawableTop="@drawable/icon_star"
            android:drawableTint="@color/gold_500"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl"
            android:textAllCaps="true"
            tools:text="CARA" />

        <Button
            android:id="@+id/btnTails"
            style="@style/Widget.W2W.Button.Answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:drawableTop="@drawable/icon_sports_soccer"
            android:drawableTint="@color/gold_500"
            android:drawablePadding="@dimen/space_sm"
            android:gravity="center"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl"
            android:textAllCaps="true"
            tools:text="COROA" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCoinTossHint"
        style="@style/TextAppearance.W2W.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:text="@string/ui_coin_tv_coin_toss_hint" />
</LinearLayout>
