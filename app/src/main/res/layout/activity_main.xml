<?xml version="1.0" encoding="utf-8"?>
<!--
    Ecrã principal. Fundo desenhado (sem imagens pesadas), cartão de progresso,
    cartão de pontos e três botões. Os botões de debug só aparecem em versões de debug.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    style="@style/Widget.W2W.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Linhas de campo, decorativas -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ds_pitch_lines" />

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <!-- Cabeçalho -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_sports_soccer"
                android:tint="@color/gold_500" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.W2W.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/gold_500"
                android:textSize="48sp" />

            <TextView
                style="@style/TextAppearance.W2W.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_tagline" />

            <!-- Cartão: passos de hoje -->
            <LinearLayout
                style="@style/Widget.W2W.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/icon_directions_walk"
                        android:tint="@color/gold_500" />

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/main_progress_title"
                        android:textAllCaps="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSteps"
                    style="@style/TextAppearance.W2W.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    tools:text="3,000 / 10,000 passos" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/progressBarSteps"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="16dp"
                        android:layout_weight="1"
                        android:progressDrawable="@drawable/ds_progress_bar"
                        tools:progress="30" />

                    <TextView
                        android:id="@+id/tvPercentage"
                        style="@style/Widget.W2W.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:textColor="@color/text_primary"
                        tools:text="30%" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cartão: pontos disponíveis -->
            <LinearLayout
                style="@style/Widget.W2W.Card.Highlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPoints"
                    style="@style/TextAppearance.W2W.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold_300"
                    tools:text="300 Pontos" />

                <TextView
                    style="@style/TextAppearance.W2W.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_points_expiry" />
            </LinearLayout>

            <!-- Botões -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                style="@style/Widget.W2W.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/main_btn_play"     app:icon="@drawable/icon_play_arrow"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconPadding="@dimen/space_sm"
                app:iconTint="@color/text_on_gold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProgress"
                style="@style/Widget.W2W.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/main_btn_progress"     app:icon="@drawable/icon_bar_chart"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconPadding="@dimen/space_sm"
                app:iconTint="@color/gold_300" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHelp"
                style="@style/Widget.W2W.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/main_btn_help"     app:icon="@drawable/icon_help_outline"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconPadding="@dimen/space_sm"
                app:iconTint="@color/gold_300" />

            <!-- Só em debug: atalhos para testar sem andar -->
            <LinearLayout
                android:id="@+id/debugRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.W2W.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_debug_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTest"
                        style="@style/Widget.W2W.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:minHeight="@dimen/touch_min"
                        android:textSize="@dimen/text_label"
                        tools:text="+1000 passos" />

                    <Button
                        android:id="@+id/btnTestWeek"
                        style="@style/Widget.W2W.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/main_debug_test_week"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
