<?xml version="1.0" encoding="utf-8"?>
<!--
    Progresso: estatísticas da semana (grelha 2x2) e gráfico de barras de passos por dia.
    Sem dados, só aparece o estado vazio.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.W2W.Screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ds_pitch_lines" />

    <ScrollView
        android:id="@+id/progressScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Cabeçalho -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_bar_chart"
                android:tint="@color/gold_500" />

            <TextView
                style="@style/TextAppearance.W2W.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_title"
                android:textAllCaps="true"
                android:textColor="@color/gold_500" />

            <TextView
                style="@style/TextAppearance.W2W.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_subtitle" />

            <!-- Estado vazio -->
            <LinearLayout
                android:id="@+id/emptyState"
                style="@style/Widget.W2W.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_xl"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_directions_walk"
                    android:tint="@color/text_secondary" />

                <TextView
                    style="@style/TextAppearance.W2W.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/progress_empty_title" />

                <TextView
                    style="@style/TextAppearance.W2W.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:text="@string/progress_empty_message"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Estatísticas -->
            <LinearLayout
                android:id="@+id/statsCard"
                style="@style/Widget.W2W.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/progress_stats_title" />

                    <TextView
                        android:id="@+id/tvPeriodo"
                        style="@style/Widget.W2W.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Últimos 7 dias" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:background="@drawable/ds_chip_on_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_directions_walk"
                            android:tint="@color/grass_400" />

                        <TextView
                            android:id="@+id/tvTotalSteps"
                            style="@style/TextAppearance.W2W.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="42.500" />

                        <TextView
                            style="@style/TextAppearance.W2W.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_stat_total" />
                    </LinearLayout>

                    <!-- Média -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:background="@drawable/ds_chip_on_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_bar_chart"
                            android:tint="@color/grass_400" />

                        <TextView
                            android:id="@+id/tvAverageSteps"
                            style="@style/TextAppearance.W2W.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="6.071" />

                        <TextView
                            style="@style/TextAppearance.W2W.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_stat_average" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <!-- Melhor dia -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:layout_weight="1"
                        android:background="@drawable/ds_chip_on_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_star"
                            android:tint="@color/gold_500" />

                        <TextView
                            android:id="@+id/tvBestDaySteps"
                            style="@style/TextAppearance.W2W.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gold_500"
                            tools:text="9.800" />

                        <TextView
                            style="@style/TextAppearance.W2W.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_stat_best" />
                    </LinearLayout>

                    <!-- Meta -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:layout_weight="1"
                        android:background="@drawable/ds_chip_on_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/icon_flag"
                            android:tint="@color/gold_500" />

                        <TextView
                            android:id="@+id/tvDailyGoal"
                            style="@style/TextAppearance.W2W.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/gold_500"
                            tools:text="10.000" />

                        <TextView
                            style="@style/TextAppearance.W2W.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/progress_stat_goal" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Gráfico -->
            <LinearLayout
                android:id="@+id/chartCard"
                style="@style/Widget.W2W.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.W2W.Heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/progress_chart_card_title" />

                    <TextView
                        style="@style/TextAppearance.W2W.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_chart_card_unit" />
                </LinearLayout>

                <pt.ubi.pdm.quizpenaltis.ui.progress.CustomBarChart
                    android:id="@+id/stepsChart"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="@dimen/space_md" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBack"
                style="@style/Widget.W2W.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/progress_btn_back" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
